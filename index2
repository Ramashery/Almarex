  function closeMenu(){[toggle,mnav,bd].forEach(function(e){e.classList.remove('open')})}
  toggle.addEventListener('click',function(){[toggle,mnav,bd].forEach(function(e){e.classList.toggle('open')})});
  bd.addEventListener('click',closeMenu);
  $$('a',mnav).forEach(function(a){a.addEventListener('click',closeMenu)});

  /* ---- Reveal on scroll ---- */
  var rev=$$('.reveal');
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(es){es.forEach(function(en){if(en.isIntersecting){en.target.classList.add('in');io.unobserve(en.target)}})},{threshold:.15,rootMargin:'0px 0px -60px 0px'});
    rev.forEach(function(el){io.observe(el)});
  }else rev.forEach(function(el){el.classList.add('in')});

  /* ---- Contact form → opens the visitor's mail app (static site, no backend) ---- */
  $('#cform').addEventListener('submit',function(e){
    e.preventDefault();var f=e.target.elements;
    var body_='Name: '+f.fname.value+'\nEmail: '+f.femail.value+'\nCompany: '+f.fcompany.value+'\n\n'+f.fmsg.value;
    location.href='mailto:ceo@almarex.ae?subject='+encodeURIComponent('Website enquiry — '+f.fname.value)+'&body='+encodeURIComponent(body_);
  });

  /* ---- Crossfade slideshow (hero + footer) ---- */
  function crossfade(sel){
    var vs=$$(sel);if(!vs.length)return;var cur=0,busy=false,F=1.2;
    function go(n){
      var c=vs[cur],x=vs[n];x.currentTime=0;x.play().catch(function(){});x.classList.add('bg-video-active');c.classList.remove('bg-video-active');cur=n;
      setTimeout(function(){c.pause();busy=false},F*1000);
    }
    function next(i){if(i!==cur||busy)return;busy=true;go((cur+1)%vs.length)}
    vs.forEach(function(v,i){
      v.addEventListener('timeupdate',function(){var l=v.duration-v.currentTime;if(l<=F&&l>0)next(i)});
      v.addEventListener('ended',function(){next(i)});
    });
    vs[0].classList.add('bg-video-active');vs[0].play().catch(function(){});
  }
  crossfade('.hero-video-wrap .bg-video');
  crossfade('.footer-video-wrap .footer-bg-video');
})();
</script>

