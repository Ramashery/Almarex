  });

  /* ---- HERO: the whole page is a chain of hero slides ----
     Every slide = a video layer + its own pinned text scene (the stepped 4-col / 3-col layout).
     Scroll input (wheel / touch / keys) first drives the text scene of the current slide (blur-in -> sharp -> blur-out).
     When the scene is finished, the next slide warps in vertically (tpl_services mechanics) and pins in turn.
     After the last scene the hero unpins and the page scrolls on to the lead form and the footer.
     Up reverses everything; at the very top of the page, scrolling up re-enters the last scene. ---- */
  (function(){
    var hero=heroEl;if(!hero)return;
    var layers=$$('.hs',hero),vids=layers.map(function(l){return $('video',l)});
    var N=layers.length,LAST=N-1;
    var SV_MS=1750,SV_SX=2,SV_SY=1.5,SV_ROT=20,SV_OUT=100,SV_IN=35;      /* same figures as tpl_services */
    var EASE_60=reduce?1:.05,TOUCH_GAIN=1.6,FLING_MS=220,FLING_MIN=.1,FLING_MAX=1300,STEP=80,SQ_DIM=.55,TEXT_MIN=1800,TEXT_VH=2.4;
    var OPEN=.26;                                           /* after a nav jump / the intro, the title is shown at this point of its scene (0 = wait for scroll) */
    var cur=0,busy=false,released=false,want=0,acc=0,gen=0;
    var BASE=TEXT_MIN,TEXT=TEXT_MIN,pos=0,disp=0,raf=0,last=0,hhPx=150;
    var dim=$('.hero-dim',hero),noop=function(){};
    var smooth=function(x){x=x<0?0:x>1?1:x;return x*x*(3-2*x)};

    /* ---- text scenes ---- */
    function wrapB(el){if(!el)return null;el.classList.add('hx-b');return{el:el,last:''}}
    var scenes={},navMap={};
    $$('.hx',hero).forEach(function(col){
      var k=col.getAttribute('data-slide'),items=$$('.hx-it',col).map(wrapB);
      scenes[k]={col:col,photo:wrapB($('.hx-ph',col)),num:wrapB($('.hx-lab',col)),titles:$$('.hx-t',col),
        parts:$$('.hx-t',col).map(wrapB),lead:wrapB($('.hx-lead',col)),rule:$('.hx-rule',col),ruleLast:-1,
        items:items,len:items.length>=3?1:(items.length?.85:.6),colH:600};      /* scenes with fewer blocks need less scrolling */
      var nv=col.getAttribute('data-nav');if(nv)navMap[nv]=+k;
    });
    var lenCur=function(){return scenes[cur]?scenes[cur].len:1};
    /* shrink the stepped title so the widest line still fits between its column and the right edge */
    function fit(o){
      o.col.style.setProperty('--hxs',1);
      var cs=getComputedStyle(o.col),cr=o.col.getBoundingClientRect();
      var L=cr.left+parseFloat(cs.paddingLeft),R=cr.right-parseFloat(cs.paddingRight),min=1;
      o.titles.forEach(function(p){
        var w=p.scrollWidth,js=getComputedStyle(p).justifySelf;
        var avail=(js==='end'||js==='flex-end'||js==='right')?R-L:R-p.getBoundingClientRect().left;
        if(w>avail&&avail>0)min=Math.min(min,avail/w);
      });
      o.col.style.setProperty('--hxs',min<1?(min*.97).toFixed(3):1);
    }
    function setText(){TEXT=Math.max(1,Math.round(BASE*lenCur()))}
    function measure(){
      var vh=innerHeight;
      hhPx=header.offsetHeight||150;
      BASE=Math.max(TEXT_MIN,Math.round(TEXT_VH*vh));
      var nt=Math.max(1,Math.round(BASE*lenCur()));
      if(TEXT>0){pos=pos/TEXT*nt;disp=disp/TEXT*nt}
      TEXT=nt;
      Object.keys(scenes).forEach(function(k){var o=scenes[k];fit(o);o.colH=o.col.offsetHeight});
      render();
    }

    function put(blk,appear,soften,out){
      if(!blk)return;
      var a=smooth(appear),m=1-soften,op=a*(.3+.7*m);
      var bl=reduce?0:(1-a)*12+soften*4+out*10,ty=reduce?0:(1-a)*26-out*14;
      var key=op.toFixed(3)+'|'+bl.toFixed(1)+'|'+ty.toFixed(1);
      if(key===blk.last)return;blk.last=key;
      blk.el.style.opacity=op.toFixed(3);
      blk.el.style.filter=bl>.05?'blur('+bl.toFixed(1)+'px)':'none';
      blk.el.style.transform='translate3d(0,'+ty.toFixed(1)+'px,0)';
    }
    /* t = 0..1 over the whole scene:
       .02-.24 label + title lines blur in, one level after another   .20-.32 lead   .30-.42 rule drawn
       .38-.84 the points land one by one (newest sharp, earlier ones soften)
       .86-.94 everything in focus   .96-1 blur out */
    function paintScene(o,t){
      var on=t>0&&t<1;
      o.col.style.visibility=on?'visible':'hidden';
      if(!on)return;
      var vh=innerHeight,topR=Math.max(96,hhPx),availH=vh-topR-32;
      var cy=Math.max(topR,(vh-o.colH)/2);
      if(o.colH>availH)cy=topR-(o.colH-availH)*smooth((t-.3)/.5);
      o.col.style.transform='translate3d(0,'+cy.toFixed(1)+'px,0)';
      var n=o.items.length,out=smooth((t-.96)/.04),fin=smooth((t-.86)/.08);
      var dimH=n?1-.55*smooth((t-.38)/.12)*(1-fin):1;
      o.col.style.opacity=(1-out).toFixed(3);
      var softHead=(1-dimH)/.55*.5,j;
      put(o.photo,(t-.10)/.16,0,out);
      put(o.num,(t-.02)/.10,softHead*.5,out);
      for(j=0;j<o.parts.length;j++)put(o.parts[j],(t-(.02+j*.06))/.10,softHead,out);
      put(o.lead,(t-.20)/.12,softHead,out);
      if(o.rule){var rl=Math.round(smooth((t-.30)/.12)*1000)/1000;if(rl!==o.ruleLast){o.ruleLast=rl;o.rule.style.transform='scaleX('+rl+')'}}
      for(j=0;j<n;j++){
        var st=.38+j*.12,next=(j<n-1)?smooth((t-(st+.12))/.08):0;
        put(o.items[j],(t-st)/.10,next*(1-fin),out);
      }
    }
    function render(){
      var t=0;
      Object.keys(scenes).forEach(function(k){
        var o=scenes[k];
        if(+k===cur&&!busy){t=Math.min(1,Math.max(0,disp/TEXT));paintScene(o,t)}
        else o.col.style.visibility='hidden';
      });
      dim.style.opacity=(SQ_DIM*smooth(t/.05)*(1-smooth((t-.95)/.05))).toFixed(3);
      hero.classList.toggle('is-s0',cur===0&&!busy&&!released&&t<.5);   /* "Scroll" cue only while the first title is still arriving */
    }

    /* ---- video loading: only the current slide and its neighbours keep a source ---- */
    function prime(c){
      vids.forEach(function(v,i){
        if(Math.abs(i-c)<=1){if(!v.getAttribute('src')){v.src=VIDS[i%VIDS.length];v.load()}}
        else if(v.getAttribute('src')){v.pause();v.removeAttribute('src');v.load()}
      });
    }

    /* ---- slide change: the tpl_services vertical warp ---- */
    function setState(i,s){
      layers[i].style.setProperty('--hs-oy',s.oy+'%');
      var v=vids[i].style;
      v.setProperty('--hs-iy',s.iy+'%');v.setProperty('--hs-sx',s.sx);v.setProperty('--hs-sy',s.sy);
      v.setProperty('--hs-rot',s.rot+'deg');v.setProperty('--hs-op',s.op);
    }
    var REST=function(op){return{oy:0,iy:0,sx:1,sy:1,rot:0,op:op}};
    function playV(v,fromStart){try{if(fromStart)v.currentTime=0}catch(e){}var p=v.play();if(p&&p.catch)p.catch(noop)}

    function go(to,dir){
      if(busy||to===cur||to<0||to>LAST)return;
      busy=true;var from=cur,myGen=gen;cur=to;
      want=0;acc=0;setText();pos=disp=(dir>0?0:TEXT);
      var tw=layers[to],fw=layers[from],tv=vids[to],fv=vids[from];
      prime(to);playV(tv,true);
      if(reduce){
        fw.classList.remove('is-active');fv.pause();setState(from,REST(0));
        tw.classList.add('is-active');setState(to,REST(1));
        busy=false;render();kick();return;
      }
      tw.classList.add('is-active','is-instant');
      setState(to,{oy:SV_OUT*dir,iy:-SV_IN*dir,sx:SV_SX,sy:SV_SY,rot:SV_ROT,op:.5});   /* park the newcomer off-screen, pre-warped */
      void tw.offsetWidth;
      requestAnimationFrame(function(){
        if(myGen!==gen)return;
        tw.classList.remove('is-instant');
        setState(to,REST(1));
        setState(from,{oy:-SV_OUT*dir,iy:SV_IN*dir,sx:SV_SX,sy:SV_SY,rot:-SV_ROT,op:.5});
        fw.classList.remove('is-active');
      });
      setTimeout(function(){
        if(myGen!==gen)return;
        fv.pause();fw.classList.add('is-instant');setState(from,REST(0));void fw.offsetWidth;fw.classList.remove('is-instant');
        busy=false;render();kick();
      },SV_MS);
      render();
    }
    /* instant jump to any slide (menu links, "Home", engaging the last scene again) */
    function jump(i,atEnd){
      gen++;busy=false;released=false;want=0;acc=0;cur=i;setText();
      pos=disp=atEnd?TEXT:0;
      layers.forEach(function(l,k){
        l.classList.add('is-instant');l.classList.toggle('is-active',k===i);
        setState(k,REST(k===i?1:0));void l.offsetWidth;l.classList.remove('is-instant');
        if(k!==i)vids[k].pause();
      });
      prime(i);playV(vids[i],true);
      render();
    }
    function toSlide(i){
      if(root.classList.contains('intro'))return;
      if(window.scrollY>0)window.scrollTo({top:0,left:0,behavior:'instant'});
      jump(i,false);
      heroApi.open();
    }
    function toContact(){
      if(root.classList.contains('intro'))return;
      if(!released){jump(LAST,true);released=true}
      var c=document.getElementById('contact');if(c)c.scrollIntoView({behavior:'smooth',block:'start'});
    }
    function release(){released=true;want=0;acc=0;render()}
    function engage(){released=false;cur=LAST;setText();pos=disp=TEXT;want=0;acc=0;render()}
    heroApi.open=function(){if(cur===0&&!busy&&!released&&pos===0&&OPEN>0){pos=Math.round(TEXT*OPEN);kick()}};

    /* ---- input -> scene position ---- */
    function input(dy){
      if(busy||!dy)return;
      if(want&&dy*want<0)want=0;
      if(dy>0){
        if(acc<0)acc=0;
        if(pos<TEXT){pos=Math.min(TEXT,pos+dy);acc=0;want=0}
        else{acc+=dy;if(acc>=STEP)want=1}
      }else{
        if(acc>0)acc=0;
        if(pos>0){pos=Math.max(0,pos+dy);acc=0;want=0}
        else{acc+=dy;if(acc<=-STEP)want=-1}
      }
      kick();
    }
    function tick(now){
      raf=0;
      var dt=last?Math.min(50,now-last):16.667;last=now;
      var k=1-Math.pow(1-EASE_60,dt/16.667),d=pos-disp;
      if(Math.abs(d)<.2)disp=pos;else disp+=d*k*1.2;
      if(!busy){
        render();
        if(want){                                           /* change slide only once the text has fully come in / gone out */
          var ready=want>0?(pos>=TEXT&&disp>=TEXT-1):(pos<=0&&disp<=1);
          if(ready){var w=want;want=0;if(w>0){if(cur<LAST)go(cur+1,1);else release()}else{if(cur>0)go(cur-1,-1);else acc=0}}
        }
      }
      if(!busy&&(disp!==pos||want))raf=requestAnimationFrame(tick);else last=0;
    }
    function kick(){if(!raf){last=0;raf=requestAnimationFrame(tick)}}

    function menuOpen(){var m=$('#mobileNav');return m&&m.classList.contains('open')}
    /* returns true when the hero consumed the gesture */
    function route(dy,e){
      if(root.classList.contains('intro'))return false;
      if(menuOpen()){if(e&&e.cancelable)e.preventDefault();return true}
      if(window.scrollY>1)return false;                     /* page already scrolled: native scrolling */
      if(released){if(dy<0)engage();else return false}
      if(e&&e.cancelable)e.preventDefault();
      input(dy);return true;
    }
    addEventListener('wheel',function(e){
      if(e.ctrlKey||Math.abs(e.deltaX)>Math.abs(e.deltaY))return;
      var dy=e.deltaY;if(e.deltaMode===1)dy*=16;else if(e.deltaMode===2)dy*=innerHeight;
      route(dy,e);
    },{passive:false});

    var ty=null,tt=0,tv=0,touching=false;
    addEventListener('touchstart',function(e){
      if(e.touches.length!==1){ty=null;return}
      ty=e.touches[0].clientY;tt=performance.now();tv=0;touching=false;
    },{passive:true});
    addEventListener('touchmove',function(e){
      if(ty===null||e.touches.length!==1)return;
      var y=e.touches[0].clientY,now=performance.now(),dy=(ty-y)*TOUCH_GAIN;
      tv=tv*.7+(dy/Math.max(1,now-tt))*.3;tt=now;ty=y;
      touching=route(dy,e);
    },{passive:false});
    function touchEnd(){
      if(touching&&!busy){
        var v=(performance.now()-tt>80)?0:tv;
        if(Math.abs(v)>FLING_MIN)input(Math.max(-FLING_MAX,Math.min(FLING_MAX,v*FLING_MS)));
      }
      ty=null;touching=false;
    }
    addEventListener('touchend',touchEnd,{passive:true});
    addEventListener('touchcancel',touchEnd,{passive:true});

    addEventListener('keydown',function(e){
      var a=document.activeElement;if(a&&/^(INPUT|TEXTAREA|SELECT)$/.test(a.tagName))return;
      if(e.altKey||e.ctrlKey||e.metaKey)return;
      var vh=innerHeight,dy=null;
      switch(e.key){
        case 'ArrowDown':dy=90;break;
        case 'ArrowUp':dy=-90;break;
        case 'PageDown':dy=vh*.85;break;
        case 'PageUp':dy=-vh*.85;break;
        case ' ':dy=e.shiftKey?-vh*.85:vh*.85;break;
        default:return;
      }
      route(dy,e);
    });

    /* the scrollbar (or anything else) moved the page while a slide was still pinned: treat the hero as finished */
    addEventListener('scroll',function(){
      if(!released&&!busy&&window.scrollY>40&&!root.classList.contains('intro')){jump(LAST,true);released=true}
    },{passive:true});

    /* menu / footer links: "Home" and the logo go to slide 1, section links to the matching slide, "Contact" to the lead form */
    $$('a[href^="#"]').forEach(function(a){
      var h=a.getAttribute('href');if(!h||h==='#')return;
      a.addEventListener('click',function(e){
        var id=h.slice(1);
        if(id==='top'){e.preventDefault();toSlide(0)}
        else if(id==='contact'){e.preventDefault();toContact()}
        else if(Object.prototype.hasOwnProperty.call(navMap,id)){e.preventDefault();toSlide(navMap[id])}
      });
    });

    /* keep the active slide's video from running while the hero is off screen */
    if('IntersectionObserver' in window){
      new IntersectionObserver(function(es){
        var v=vids[cur];if(!v)return;
        if(es[0].isIntersecting)v.play().catch(noop);else v.pause();
      }).observe(hero);
    }

    setState(0,REST(1));
    var rt=0;addEventListener('resize',function(){clearTimeout(rt);rt=setTimeout(measure,120)});
    measure();
    if(document.fonts&&document.fonts.ready)document.fonts.ready.then(measure);
    addEventListener('load',measure);
  })();

  /* ---- Crossfade slideshow (footer) ---- */
  function crossfade(sel){
    var vs=$$(sel);if(!vs.length)return;var cur=0,busy=false,F=1.2;
    function go(n){
      var c=vs[cur],x=vs[n];x.currentTime=0;x.play().catch(function(){});x.classList.add('bg-video-active');c.classList.remove('bg-video-active');cur=n;
      setTimeout(function(){c.pause();busy=false},F*1000);
    }
    function next(i){if(i!==cur||busy)return;busy=true;go((cur+1)%vs.length)}
    vs.forEach(function(v,i){
      v.addEventListener('timeupdate',function(){var l=v.duration-v.currentTime;if(l<=F&&l>0)next(i)});
      v.addEventListener('ended',function(){next(i)});
    });
    vs[0].classList.add('bg-video-active');vs[0].play().catch(function(){});
  }
  crossfade('.footer-video-wrap .footer-bg-video');
})();
</script>

</body>
