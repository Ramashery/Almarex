<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ALMAREX AVIATION VENTURES FZCO | International Aviation Business Platform, Dubai</title>
<meta name="description" content="ALMAREX AVIATION VENTURES FZCO — Dubai-based international aviation business platform: airline representation, aircraft &amp; fleet solutions, charter, cargo, advisory and investment.">
<meta property="og:type" content="website">
<meta property="og:site_name" content="ALMAREX AVIATION VENTURES FZCO">
<meta property="og:title" content="ALMAREX — Where Aviation Connects the World">
<meta property="og:description" content="Dubai-based international aviation business platform. Airline representation, aircraft &amp; fleet solutions, charter, cargo, advisory and investment.">
<meta property="og:image" content="https://i.postimg.cc/Y9kDdLZd/dubai.jpg">
<meta name="twitter:card" content="summary_large_image">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Manrope:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#F7F4EC;
    --bg-soft:#EFEAE0;
    --surface:#FFFFFF;
    --navy:#101C2C;
    --navy-2:#1B2E44;
    --teal:#2E5F5A;
    --bronze:#A9814C;
    --ink:#1B2430;
    --ink-soft:#5B6472;
    --line:#DAD3C2;
    --line-dark:rgba(255,255,255,.18);
    --max:1220px;
    --gutter:clamp(24px, 5vw, 64px);
    --rail-x: 6px;
  }

  *,*::before,*::after{box-sizing:border-box;}
  html{scroll-behavior:smooth;overflow-x:hidden;}
  body{
    margin:0;
    overflow-x:clip;
    background:var(--bg);
    color:var(--ink);
    font-family:'Manrope', sans-serif;
    font-weight:400;
    line-height:1.55;
    -webkit-font-smoothing:antialiased;
  }
  img{max-width:100%;display:block;}
  a{color:inherit;text-decoration:none;}
  ul{margin:0;padding:0;list-style:none;}
  h1,h2,h3{margin:0;font-family:'Fraunces', serif;font-weight:500;color:var(--navy);letter-spacing:-0.01em;}
  h1 em, h2 em, h3 em, p em{font-style:italic;font-weight:400;color:var(--teal);}
  p{margin:0;}
  button{font-family:inherit;}

  .wrap{max-width:var(--max);margin:0 auto;padding-left:var(--gutter);padding-right:var(--gutter);}

  .eyebrow{
    display:flex;align-items:center;gap:10px;
    font-family:'IBM Plex Mono', monospace;
    font-size:.72rem;
    letter-spacing:.14em;
    text-transform:uppercase;
    color:var(--teal);
    margin-bottom:18px;
  }
  .eyebrow .code{
    display:inline-flex;align-items:center;justify-content:center;
    min-width:auto;
    padding:2px 8px;
    border:1px solid var(--teal);
    border-radius:20px;
    color:var(--teal);
    font-size:.68rem;
  }
  .eyebrow.on-dark{color:#CFE3D8;}
  .eyebrow.on-dark .code{border-color:#CFE3D8;color:#CFE3D8;}

  /* ---------- Header ---------- */
  .site-header{
    position:fixed;top:0;left:0;right:0;z-index:100;
    padding:22px var(--gutter);
    display:flex;align-items:center;justify-content:flex-end;
    gap:clamp(18px, 3vw, 40px);
    background:transparent;
    box-shadow:none;
    transition:background .5s ease, box-shadow .5s ease, padding .3s ease;
  }
  .site-header.scrolled{
    background:transparent;
    backdrop-filter:none;
    box-shadow:none;
    padding-top:22px;padding-bottom:22px;
  }

  .nav-links{display:flex;align-items:center;gap:clamp(18px, 2.4vw, 34px);}
  .nav-links a{
    font-size:.88rem;font-weight:600;color:#F7F4EC;
    position:relative;padding-bottom:4px;
    white-space:nowrap;
    transition:color .3s ease;
  }
  .site-header.on-light .nav-links a{color:var(--navy);}
  .nav-links a::after{
    content:'';position:absolute;left:0;bottom:0;height:1px;width:0;
    background:currentColor;transition:width .3s ease;
  }
  .nav-links a:hover::after{width:100%;}

  .header-right{display:flex;align-items:center;gap:clamp(14px, 2vw, 26px);flex:none;}
  .header-utility{
    font-family:'IBM Plex Mono', monospace;
    font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;
    color:#F7F4EC;
    white-space:nowrap;
    transition:color .3s ease;
  }
  .site-header.on-light .header-utility{color:var(--ink-soft);}

  .menu-toggle{display:none;background:none;border:none;cursor:pointer;padding:6px;z-index:110;flex:none;}
  .menu-toggle span{display:block;width:24px;height:2px;margin:5px 0;background:#F7F4EC;transition:.3s;}
  .site-header.on-light .menu-toggle span{background:var(--navy);}
  .menu-toggle.open span{background:#F7F4EC !important;}
  .menu-toggle.open span:nth-child(1){transform:translateY(7px) rotate(45deg);}
  .menu-toggle.open span:nth-child(2){opacity:0;}
  .menu-toggle.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg);}

  /* Overlay backdrop behind the sliding mobile panel */
  .mobile-nav-backdrop{
    position:fixed;inset:0;z-index:104;
    background:rgba(16,28,44,.4);
    opacity:0;visibility:hidden;
    transition:opacity .5s ease, visibility .5s ease;
  }
  .mobile-nav-backdrop.open{opacity:1;visibility:visible;}

  /* ---------- Hero ---------- */
  .hero{
    position:relative;
    min-height:100vh;
    display:flex;align-items:flex-end;
    overflow:hidden;
    background:linear-gradient(155deg, var(--navy) 0%, var(--navy-2) 100%);
    isolation:isolate;
  }
  .hero-video-wrap{position:absolute;inset:0;z-index:0;}
  .hero-video-wrap video{
    position:absolute;top:50%;left:50%;
    min-width:100%;min-height:100%;width:auto;height:auto;
    transform:translate(-50%,-50%);
    object-fit:cover;
    opacity:0;
    transition:opacity 1.2s ease-in-out;
  }
  .hero-video-wrap video.bg-video-active{opacity:1;}
  .hero-overlay{
    position:absolute;inset:0;z-index:1;
    background:linear-gradient(180deg, rgba(16,28,44,.55) 0%, rgba(27,46,68,.32) 38%, rgba(16,28,44,.85) 100%);
  }
  .hero-inner{
    position:relative;z-index:2;
    width:100%;
    padding:180px var(--gutter) 90px;
  }
  .hero-inner .wrap{padding:0;max-width:calc(var(--max) - 0px);margin:0 auto;padding-left:0;padding-right:0;}
  .hero-content{max-width:800px;}
  .hero h1{
    color:#F7F4EC;
    font-size:clamp(2.6rem, 7vw, 5.4rem);
    line-height:1.03;
    font-weight:400;
  }
  .hero h1 .line{
    display:block;
    opacity:0;
    transform:translateY(28px);
    animation:riseIn 1.1s cubic-bezier(.22,.61,.36,1) forwards;
  }
  .hero h1 .line:nth-child(1){animation-delay:.25s;}
  .hero h1 .line:nth-child(2){animation-delay:.55s;font-style:italic;font-weight:400;color:#D8C6A6;}
  @keyframes riseIn{to{opacity:1;transform:translateY(0);}}

  .hero-sub{
    margin-top:28px;
    max-width:560px;
    color:rgba(247,244,236,.86);
    font-size:1.06rem;
    line-height:1.6;
    opacity:0;
    animation:riseIn 1.1s cubic-bezier(.22,.61,.36,1) forwards;
    animation-delay:.85s;
  }
  .hero-ctas{
    margin-top:40px;
    display:flex;gap:16px;flex-wrap:wrap;
    opacity:0;
    animation:riseIn 1.1s cubic-bezier(.22,.61,.36,1) forwards;
    animation-delay:1.1s;
  }
  .scroll-cue{
    position:absolute;right:var(--gutter);bottom:34px;z-index:2;
    display:flex;align-items:center;gap:10px;
    color:rgba(247,244,236,.7);
    font-family:'IBM Plex Mono', monospace;
    font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;
    opacity:0;
    animation:riseIn 1s ease forwards;
    animation-delay:1.3s;
  }
  .scroll-cue .stick{width:1px;height:34px;background:rgba(247,244,236,.5);position:relative;overflow:hidden;}
  .scroll-cue .stick::after{
    content:'';position:absolute;left:0;top:-100%;width:100%;height:100%;background:#F7F4EC;
    animation:stickMove 2.2s ease-in-out infinite;
  }
  @keyframes stickMove{0%{top:-100%;}50%{top:100%;}100%{top:100%;}}

  .block{position:relative;z-index:1;padding-top:96px;padding-bottom:96px;}
  .block + .block{border-top:1px solid var(--line);}

  /* ---------- Reveal on scroll ---------- */
  .reveal{opacity:0;transform:translateY(22px);transition:opacity .8s cubic-bezier(.22,.61,.36,1), transform .8s cubic-bezier(.22,.61,.36,1);}
  .reveal.in{opacity:1;transform:translateY(0);}
  .reveal-delay-1{transition-delay:.08s;}
  .reveal-delay-2{transition-delay:.16s;}
  .reveal-delay-3{transition-delay:.24s;}
  .reveal-delay-4{transition-delay:.32s;}
  .reveal-delay-5{transition-delay:.4s;}
  .reveal-delay-6{transition-delay:.48s;}

  /* ---------- Section heading pattern ---------- */
  .section-head{max-width:760px;margin-bottom:56px;}
  .section-head h2{font-size:clamp(1.9rem, 3.4vw, 2.7rem);line-height:1.15;}
  .section-head p{margin-top:20px;color:var(--ink-soft);font-size:1.02rem;max-width:640px;}

  /* ---------- Intro ---------- */
  .intro-text{max-width:820px;}
  .intro-text h2{font-size:clamp(1.9rem, 3.6vw, 2.9rem);line-height:1.2;}
  .intro-text p{margin-top:24px;color:var(--ink-soft);font-size:1.08rem;max-width:680px;}

  /* ---------- Pillars ---------- */
  .pillars-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line);}
  .pillar{background:var(--bg);padding:44px 36px;transition:background .4s ease;}
  .pillar:hover{background:var(--surface);}
  .pillar-code{
    font-family:'IBM Plex Mono', monospace;font-size:.75rem;letter-spacing:.12em;
    color:var(--bronze);margin-bottom:22px;display:block;
  }
  .pillar h3{font-size:1.5rem;margin-bottom:14px;}
  .pillar p{color:var(--ink-soft);font-size:.98rem;}

  /* ---------- Capabilities ---------- */
  .cap-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;}
  .cap-card{
    border-top:1px solid var(--navy);
    padding-top:22px;
  }
  .cap-num{font-family:'IBM Plex Mono', monospace;font-size:.72rem;color:var(--ink-soft);letter-spacing:.1em;}
  .cap-card h3{font-size:1.28rem;margin-top:14px;font-weight:500;}
  .cap-card p{margin-top:12px;color:var(--ink-soft);font-size:.95rem;}
  .cap-cta{margin-top:56px;}

  /* ---------- Who we work with ---------- */
  .who-list{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--line);}
  .who-list li{
    padding:22px 0;border-bottom:1px solid var(--line);
    display:flex;align-items:baseline;gap:16px;
    font-family:'Fraunces', serif;font-size:1.18rem;color:var(--navy);
  }
  .who-list li span.n{font-family:'IBM Plex Mono', monospace;font-size:.75rem;color:var(--bronze);}

  /* ---------- Why ---------- */
  .why-grid{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:start;}
  .why-grid p{color:var(--ink-soft);font-size:1.04rem;}
  .why-list li{
    padding:16px 0;border-top:1px solid var(--line);
    display:flex;align-items:center;gap:14px;
    font-size:.98rem;color:var(--ink);
  }
  .why-list li:last-child{border-bottom:1px solid var(--line);}
  .why-list li::before{
    content:'';width:6px;height:6px;border-radius:50%;background:var(--teal);flex:none;
  }
  .why-cta{margin-top:34px;}

  /* ---------- Bridge / Dubai ---------- */
  .bridge{position:relative;overflow:hidden;}
  .bridge-grid{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;}
  .bridge-text p{margin-top:20px;color:var(--ink-soft);font-size:1.04rem;max-width:520px;}
  .bridge-map{position:relative;height:340px;overflow:hidden;}
  .bridge-map img{
    width:100%;height:100%;object-fit:cover;
    filter:saturate(.92);
  }

  /* ---------- News ---------- */
  .news-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;}
  .news-card{border-top:1px solid var(--line);padding-top:20px;}
  .news-cat{font-family:'IBM Plex Mono', monospace;font-size:.68rem;letter-spacing:.1em;text-transform:uppercase;color:var(--teal);}
  .news-card h3{font-size:1.12rem;margin-top:12px;font-weight:500;line-height:1.35;}
  .news-cta{margin-top:48px;}

  /* ---------- Final CTA ---------- */
  .final-cta{
    background:linear-gradient(155deg, var(--navy) 0%, var(--navy-2) 100%);
    color:#F7F4EC;
    padding:110px 0;
    position:relative;
    overflow:hidden;
  }
  .final-cta::before{
    content:'';position:absolute;top:-40%;right:-10%;width:520px;height:520px;
    border:1px solid rgba(247,244,236,.08);border-radius:50%;
  }
  .final-cta::after{
    content:'';position:absolute;top:-20%;right:6%;width:340px;height:340px;
    border:1px solid rgba(247,244,236,.08);border-radius:50%;
  }
  .final-cta-inner{max-width:640px;position:relative;z-index:1;}
  .final-cta h2{color:#F7F4EC;font-size:clamp(2rem, 4vw, 3.1rem);line-height:1.15;}
  .final-cta p{margin-top:22px;color:rgba(247,244,236,.78);font-size:1.05rem;}
  .final-cta .hero-ctas{margin-top:36px;opacity:1;animation:none;}

  /* ---------- Footer ---------- */
  footer{
    position:relative;
    overflow:hidden;
    background:linear-gradient(155deg, var(--navy) 0%, var(--navy-2) 100%);
    padding:90px 0 30px;
  }
  .footer-video-wrap{position:absolute;inset:0;z-index:0;}
  .footer-video-wrap video{
    position:absolute;top:50%;left:50%;
    min-width:100%;min-height:100%;width:auto;height:auto;
    transform:translate(-50%,-50%);
    object-fit:cover;
    opacity:0;
    transition:opacity 1.2s ease-in-out;
  }
  .footer-video-wrap video.bg-video-active{opacity:1;}
  .footer-overlay{
    position:absolute;inset:0;z-index:0;
    background:transparent;
  }
  .footer-top{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:40px;padding-bottom:56px;border-bottom:1px solid rgba(247,244,236,.16);}
  .footer-brand p{margin-top:18px;color:rgba(247,244,236,.72);font-size:.95rem;max-width:320px;}
  .footer-logo img{height:24px;filter:brightness(0) invert(1);}
  .footer-col h4{
    font-family:'IBM Plex Mono', monospace;font-size:.7rem;letter-spacing:.12em;text-transform:uppercase;
    color:rgba(247,244,236,.55);margin-bottom:18px;font-weight:500;
  }
  .footer-col li{padding:6px 0;}
  .footer-col a{font-size:.92rem;color:#F7F4EC;transition:color .3s ease;}
  .footer-col a:hover{color:var(--bronze);}
  .footer-bottom{
    padding-top:24px;
    display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;
    font-size:.8rem;color:rgba(247,244,236,.55);
  }
  .footer-bottom nav{display:flex;gap:22px;flex-wrap:wrap;}
  .footer-bottom a:hover{color:var(--bronze);}

  /* ---------- Focus visibility ---------- */
  a:focus-visible, button:focus-visible{outline:2px solid var(--teal);outline-offset:3px;}

  /* ---------- Responsive ---------- */

  /* Sliding right-side panel — base rules apply from the point the
     hamburger takes over, so the panel is ready before layout narrows further. */
  .mobile-nav{
    position:fixed;top:0;right:0;bottom:0;z-index:106;
    width:min(84vw, 380px);
    background:rgba(16,28,44,.94);
    backdrop-filter:blur(16px);
    -webkit-backdrop-filter:blur(16px);
    display:flex;flex-direction:column;justify-content:center;gap:0;
    padding:0 40px;
    box-shadow:-8px 0 40px rgba(16,28,44,.25);
    transform:translateX(100%);
    transition:transform .55s cubic-bezier(.22,.61,.36,1);
  }
  .mobile-nav.open{transform:translateX(0);}
  .mobile-nav a{
    font-family:'Fraunces', serif;font-size:1.7rem;color:#F7F4EC;
    padding:13px 0;border-bottom:1px solid rgba(247,244,236,.14);
  }
  .mobile-nav .btn{margin-top:28px;align-self:flex-start;}

  @media (max-width:1180px){
    .nav-links{gap:16px;}
    .nav-links a{font-size:.82rem;}
    .header-utility{display:none;}
  }

  @media (max-width:1024px){
    .pillars-grid{grid-template-columns:1fr;background:transparent;border:none;gap:0;}
    .pillar{padding:32px 0;}
    .pillar + .pillar{border-top:1px solid var(--line);}
    .cap-grid{grid-template-columns:1fr 1fr;}
    .why-grid{grid-template-columns:1fr;gap:36px;}
    .bridge-grid{grid-template-columns:1fr;}
    .bridge-map{height:300px;}
    .news-grid{grid-template-columns:1fr;}
    .footer-top{grid-template-columns:1fr 1fr;}
  }

  @media (max-width:900px){
    :root{--gutter:24px;}
  }

  @media (max-width:840px){
    .nav-links{display:none;}
    .header-right .btn{display:none;}
    .menu-toggle{display:block;}
  }

  @media (max-width:760px){
    .hero-inner{padding:150px var(--gutter) 70px;}
    .scroll-cue{display:none;}
    .block .eyebrow .code{left:0;}
    .block{padding-top:64px;padding-bottom:64px;}
    .bridge-map{height:220px;}
    .cap-grid{grid-template-columns:1fr;}
    .who-list{grid-template-columns:1fr;}
    .footer-top{grid-template-columns:1fr;gap:36px;}
    .final-cta{padding:80px 0;}

  }

  @media (prefers-reduced-motion: reduce){
    *{animation-duration:.01ms !important;animation-iteration-count:1 !important;transition-duration:.01ms !important;scroll-behavior:auto !important;}
    .reveal{opacity:1;transform:none;}
    .hero h1 .line, .hero-sub, .hero-ctas, .scroll-cue{opacity:1;transform:none;}
  }

  /* ================= v2 ================= */
  :root{--ez:cubic-bezier(.22,.61,.36,1);--hh:150px}
  html.intro,html.intro body{overflow:hidden}
  body{overflow-x:clip}
  html{scroll-padding-top:64px}
  .rail-wrap{position:relative}

  /* Header */
  .site-header{height:var(--hh);padding:0 var(--gutter);transition:background .4s,box-shadow .4s,height .9s var(--ez),opacity .8s}
  body.scrolled .site-header{height:64px}
  .site-header.on-light{background:rgba(247,244,236,.92);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);box-shadow:0 1px 0 var(--line)}
  body:not(.logo-done) .site-header,body:not(.logo-done) .wa{opacity:0;pointer-events:none}
  .hl{font-size:.88rem;font-weight:600;color:#F7F4EC;transition:color .3s}
  .site-header.on-light .hl{color:var(--navy)}
  .hl:hover{color:var(--bronze)!important}

  /* Logo: centred intro -> top-left -> compact on scroll (single element, fixed in header) */
  .brand-logo{position:fixed;z-index:101;display:block;top:50%;left:50%;
    width:var(--w-intro,80vw);aspect-ratio:var(--la,3);transform:translate(-50%,-50%);
    animation:logoIn 1s ease both;
    transition:top .9s var(--ez),left .9s var(--ez),transform .9s var(--ez),width .9s var(--ez)}
  @keyframes logoIn{from{opacity:0}to{opacity:1}}
  body.logo-done .brand-logo{top:calc(var(--hh)/2);left:var(--gutter);transform:translate(0,-50%);width:var(--w-hero)}
  body.logo-done.scrolled .brand-logo{top:32px;width:var(--w-sm)}
  .brand-logo img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;transition:opacity .4s}
  .brand-logo .ll{filter:drop-shadow(0 1px 8px rgba(0,0,0,.35))}
  .brand-logo .ld{opacity:0}
  body.on-light .brand-logo .ld{opacity:1}
  body.on-light .brand-logo .ll{opacity:0}

  /* Hero: exactly one screen */
  .hero{height:100vh;height:100dvh;min-height:0}
  .hero-inner{padding:0 var(--gutter) clamp(48px,9vh,90px)}
  .hero h1{font-size:clamp(2.3rem,6.2vw,5rem);text-transform:none;letter-spacing:-.01em;line-height:1.08}
  .hero h1 .line:nth-child(1){animation-delay:.4s}
  .hero h1 .line:nth-child(2){animation-delay:.7s}
  .hero-sub{animation-delay:1s}
  .scroll-cue{animation-delay:1.4s}
  body:not(.logo-done) .hero h1 .line,body:not(.logo-done) .hero-sub,body:not(.logo-done) .scroll-cue{animation-play-state:paused}

  /* Platform: no table-like outline on desktop */
  @media (min-width:1025px){
    .pillars-grid{gap:56px;background:none;border:0}
    .pillar,.pillar:hover{background:none;padding:22px 0 0;border-top:1px solid var(--navy)}
  }

  /* Pinned media windows */
  .mscene{position:relative}
  .mstage{position:sticky;top:0;height:100vh;overflow:hidden;pointer-events:none}
  .mwin{position:absolute;inset:0;--e:0;--iy:21%;--ix:max(var(--gutter),calc((100% - 1100px)/2));background:var(--navy);
    clip-path:inset(calc(var(--iy)*(1 - var(--e))) calc(var(--ix)*(1 - var(--e))) round calc(18px*(1 - var(--e))))}
  .mwin video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transform:scale(calc(1.12 - .12*var(--e)))}
  .mshade{position:absolute;inset:0;background:rgba(16,28,44,.66);opacity:calc(.12 + .88*var(--e))}
